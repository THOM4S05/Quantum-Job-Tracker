# Local demonstration only. Keep this file's structure; put actual values in .env.
# Database credentials are consumed only by PostgreSQL, API, and migration tooling.
POSTGRES_DB=qtrace
POSTGRES_USER=qtrace
POSTGRES_PASSWORD=local-demo-only
# Used when running the API/migrations outside Compose. Compose overrides the host.
DB_HOST=127.0.0.1
DB_PORT=5432
